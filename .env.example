# Vorlage für Umgebungsvariablen. Echte Werte gehören ausschließlich in
# .env.local (wird von Git ignoriert) bzw. in die Geheimnisverwaltung des Hosters.
# In Entwicklungsstufe 1 wird noch KEINE dieser Variablen benötigt.

# Supabase (EU-Region, z. B. Frankfurt) – später
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig verwenden, niemals mit NEXT_PUBLIC_ versehen:
SUPABASE_SERVICE_ROLE_KEY=

# Erlaubte Google-Workspace-Domain für die Anmeldung – später
ALLOWED_GOOGLE_WORKSPACE_DOMAIN=grenford.de
